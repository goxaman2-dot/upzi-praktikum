роспатент/authors_private.txt

# Случайно установленный npm-пакет (использовался только для тестовой проверки верстки,
# к самому приложению — одному файлу index.html без сборки — отношения не имеет).
# Из-за символических ссылок внутри node_modules/.bin Git для Windows не может закоммитить
# эту папку ("Function not implemented") — поэтому она исключена из репозитория целиком.
node_modules/

# Ярлыки Windows, случайно создающиеся в папке проекта — не часть курса.
*.lnk
